{
    "name": "grocerglow",
    "version": "1.0.0",
    "description": "A local shopping-list and budget planner with per-list currencies and SQLite persistence.",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "test": "node --test test/*.test.cjs",
        "test:browser": "node test-support/browser.cjs",
        "test:lists": "node test-support/lists-browser.cjs",
        "check": "node scripts/check.cjs",
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "test:audit": "node test-support/audit-browser.cjs"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "country-to-currency": "^3.0.1",
        "express": "^5.3.0"
    },
    "devDependencies": {
        "axe-core": "4.14.0",
        "node-gyp": "12.1.0",
        "playwright": "1.62.1",
        "prettier": "3.9.10"
    },
    "private": true,
    "engines": {
        "node": ">=22 <23"
    }
}
